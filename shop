<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Kasir Toko Multi Cabang</title>
  <!-- Tailwind CSS CDN untuk styling cepat -->
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 min-h-screen p-4">

  <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-6">
    
    <!-- KOLOM KIRI: KATALOG PRODUK -->
    <div class="md:col-span-2 bg-white p-6 rounded-lg shadow-md">
      <div class="flex justify-between items-center mb-4">
        <h1 class="text-xl font-bold text-gray-800">Katalog Produk</h1>
        <span id="branchBadge" class="bg-blue-100 text-blue-800 text-xs font-semibold px-2.5 py-0.5 rounded">Cabang: BR001</span>
      </div>

      <!-- Pilih Produk Manual / Scanner Barcode -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Pilih Produk</label>
          <select id="productSelect" class="w-full border border-gray-300 p-2 rounded-md focus:ring-2 focus:ring-blue-500">
            <option value="">-- Pilih Barang --</option>
            <option value="PRD001" data-name="Minyak Goreng 1L" data-price="17000">Minyak Goreng 1L - Rp 17.000</option>
            <option value="PRD002" data-name="Gula Pasir 1Kg" data-price="15000">Gula Pasir 1Kg - Rp 15.000</option>
            <option value="PRD003" data-name="Beras 5Kg" data-price="68000">Beras 5Kg - Rp 68.000</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Jumlah (Qty)</label>
          <div class="flex gap-2">
            <input type="number" id="itemQty" value="1" min="1" class="w-full border border-gray-300 p-2 rounded-md">
            <button onclick="addToCart()" class="bg-blue-600 hover:bg-blue-700 text-white font-medium px-4 py-2 rounded-md">
              + Tambah
            </button>
          </div>
        </div>
      </div>

      <!-- Tabel Keranjang Belanja -->
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="border-b text-sm font-semibold text-gray-600 bg-gray-50">
              <th class="p-2">Produk</th>
              <th class="p-2">Harga</th>
              <th class="p-2">Qty</th>
              <th class="p-2">Subtotal</th>
              <th class="p-2 text-center">Aksi</th>
            </tr>
          </thead>
          <tbody id="cartTableBody" class="text-sm">
            <!-- Item keranjang akan muncul di sini secara dinamis -->
          </tbody>
        </table>
      </div>
    </div>

    <!-- KOLOM KANAN: RINGKASAN PEMBAYARAN -->
    <div class="bg-white p-6 rounded-lg shadow-md flex flex-col justify-between">
      <div>
        <h2 class="text-xl font-bold text-gray-800 mb-4">Ringkasan</h2>
        
        <div class="space-y-3 border-b pb-4 mb-4">
          <div class="flex justify-between text-gray-600">
            <span>No. Nota:</span>
            <span id="invoiceNum" class="font-mono font-bold text-gray-800"></span>
          </div>
          <div class="flex justify-between text-gray-600">
            <span>Metode Bayar:</span>
            <select id="paymentMethod" class="border border-gray-300 rounded p-1 text-sm">
              <option value="CASH">CASH</option>
              <option value="QRIS">QRIS</option>
              <option value="DEBIT">DEBIT</option>
            </select>
          </div>
        </div>

        <div class="bg-gray-50 p-4 rounded-lg mb-6">
          <span class="text-sm text-gray-500 block">Total Tagihan:</span>
          <span id="grandTotal" class="text-3xl font-extrabold text-blue-600">Rp 0</span>
        </div>
      </div>

      <!-- Tombol Bayar -->
      <button id="btnSubmit" onclick="processCheckout()" class="w-full bg-green-600 hover:bg-green-700 text-white font-bold py-3 rounded-lg text-lg transition duration-200">
        Bayar & Kirim
      </button>
    </div>

  </div>

  <script>
    // -------------------------------------------------------------
    // KONFIGURASI KASIR
    // -------------------------------------------------------------
    // GANTI SAMA URL WEB APP DARI GOOGLE APPS SCRIPT ANDA
    const GAS_WEB_APP_URL = "https://script.google.com/macros/s/AKfycbwg1Qo_40jtWPzYGp-OTpjz_wHTUVqAEqxpQjD1GRN7WJTxYczwBM7dWNbH_xRVu7H3Bg/exec";
    
    const CURRENT_BRANCH = "BR001";
    const CURRENT_USER = "USR01";
    let cart = [];

    // Inisialisasi No Nota Otomatis
    function generateInvoiceNumber() {
      const now = new Date();
      const dateStr = now.getFullYear().toString() +
                      String(now.getMonth() + 1).padStart(2, '0') +
                      String(now.getDate()).padStart(2, '0');
      const randomId = Math.floor(1000 + Math.random() * 9000);
      return `INV/${CURRENT_BRANCH}/${dateStr}/${randomId}`;
    }

    let currentInvoice = generateInvoiceNumber();
    document.getElementById('invoiceNum').innerText = currentInvoice;

    // -------------------------------------------------------------
    // MANAJEMEN KERANJANG
    // -------------------------------------------------------------
    function addToCart() {
      const select = document.getElementById('productSelect');
      const selectedOption = select.options[select.selectedIndex];
      const qtyInput = document.getElementById('itemQty');

      if (!select.value) {
        alert("Pilih barang terlebih dahulu!");
        return;
      }

      const productId = select.value;
      const productName = selectedOption.getAttribute('data-name');
      const price = parseInt(selectedOption.getAttribute('data-price'));
      const quantity = parseInt(qtyInput.value);

      // Cek apakah item sudah ada di keranjang
      const existingItem = cart.find(item => item.product_id === productId);
      if (existingItem) {
        existingItem.quantity += quantity;
        existingItem.subtotal = existingItem.quantity * existingItem.price;
      } else {
        cart.push({
          product_id: productId,
          name: productName,
          price: price,
          quantity: quantity,
          subtotal: price * quantity
        });
      }

      // Reset Form Input & Render Ulang
      select.value = "";
      qtyInput.value = 1;
      renderCart();
    }

    function removeFromCart(productId) {
      cart = cart.filter(item => item.product_id !== productId);
      renderCart();
    }

    function renderCart() {
      const tbody = document.getElementById('cartTableBody');
      const grandTotalElem = document.getElementById('grandTotal');
      tbody.innerHTML = "";

      let grandTotal = 0;

      if (cart.length === 0) {
        tbody.innerHTML = `<tr><td colspan="5" class="p-4 text-center text-gray-400">Keranjang masih kosong</td></tr>`;
      } else {
        cart.forEach(item => {
          grandTotal += item.subtotal;
          const tr = document.createElement('tr');
          tr.className = "border-b hover:bg-gray-50";
          tr.innerHTML = `
            <td class="p-2">${item.name}</td>
            <td class="p-2">Rp ${item.price.toLocaleString('id-ID')}</td>
            <td class="p-2">${item.quantity}</td>
            <td class="p-2 font-medium">Rp ${item.subtotal.toLocaleString('id-ID')}</td>
            <td class="p-2 text-center">
              <button onclick="removeFromCart('${item.product_id}')" class="text-red-500 hover:text-red-700 font-bold">✕</button>
            </td>
          `;
          tbody.appendChild(tr);
        });
      }

      grandTotalElem.innerText = `Rp ${grandTotal.toLocaleString('id-ID')}`;
    }

    // -------------------------------------------------------------
    // PROSES PROSES PEMBAYARAN & KIRIM KE GOOGLE APPS SCRIPT
    // -------------------------------------------------------------
    async function processCheckout() {
      if (cart.length === 0) {
        alert("Keranjang masih kosong!");
        return;
      }

      const btnSubmit = document.getElementById('btnSubmit');
      btnSubmit.disabled = true;
      btnSubmit.innerText = "Memproses...";

      // Hitung Total Akhir
      const totalAmount = cart.reduce((sum, item) => sum + item.subtotal, 0);

      // Susun Payload JSON sesuai ekspektasi doPost(e) di Google Apps Script
      const payload = {
        invoice_number: currentInvoice,
        branch_id: CURRENT_BRANCH,
        user_id: CURRENT_USER,
        total_amount: totalAmount,
        payment_method: document.getElementById('paymentMethod').value,
        items: cart.map(item => ({
          product_id: item.product_id,
          price: item.price,
          quantity: item.quantity,
          subtotal: item.subtotal
        }))
      };

      try {
        // Kirim HTTP POST ke Apps Script
        // Menggunakan mode 'no-cors' jika mengalami isu CORS standar di lingkungan browser
        const response = await fetch(GAS_WEB_APP_URL, {
          method: 'POST',
          headers: {
            'Content-Type': 'text/plain;charset=utf-8', 
          },
          body: JSON.stringify(payload)
        });

        alert("✅ Transaksi Berhasil Disimpan!");

        // Reset Keranjang dan Nota
        cart = [];
        currentInvoice = generateInvoiceNumber();
        document.getElementById('invoiceNum').innerText = currentInvoice;
        renderCart();

      } catch (error) {
        console.error("Error:", error);
        alert("❌ Terjadi kesalahan saat menyimpan transaksi.");
      } finally {
        btnSubmit.disabled = false;
        btnSubmit.innerText = "Bayar & Kirim";
      }
    }

    // Render awal
    renderCart();
  </script>
</body>
</html>
